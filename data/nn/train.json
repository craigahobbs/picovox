{
    "description": "make train's recipe - every stage's settings and seeds: the G2P network (nn/g2p.py), the teacher (nn/trainmulti.py --recipe), and the distilled student with its evaluation and gate (nn/distill.py, nn/panel.py)",
    "g2p": {
        "description": "The G2P network (nn/g2p.py): the AR encoder-decoder trained on every dictionary word, frequency-weighted, with teacher-labeled unknown words, in four stages (base, two polishes over the most frequent words, then the readers' pronunciations of the relabeled words - focus), exported at 6 bits",
        "model": {"embed": 32, "hidden": 96},
        "batch": 512,
        "alpha": 0.5,
        "uniform": 0.5,
        "unknown": 0.3,
        "threads": 1,
        "stages": [
            {"name": "base", "steps": 20000, "lr": 0.003, "warmup": 500, "seed": 1},
            {"name": "polish", "steps": 5000, "lr": 0.001, "warmup": 100, "seed": 3, "topBoost": {"share": 0.3, "count": 20000}},
            {"name": "polish2", "steps": 5000, "lr": 0.0005, "warmup": 100, "seed": 4, "topBoost": {"share": 0.4, "count": 12000}},
            {"name": "focus", "steps": 3000, "lr": 0.0005, "warmup": 100, "seed": 6, "topBoost": {"share": 0.4, "count": 12000},
             "relabel": "data/nn/g2p-relabel.json", "focusBoost": {"share": 0.02}}
        ],
        "export": {"bits": 6, "groupSize": 0, "biasBits": 8}
    },
    "teacher": {
        "description": "The teacher (nn/trainmulti.py --recipe teacher.a, then teacher.b): stage A on the readers (the 30,000-step schedule, stopped at 15,000), then stage B from A's weights with the emotional speech and the adversarial critic - B's best validation checkpoint is the teacher; the keys are nn/trainmulti.py's flags, defaults every training setting's default",
        "defaults": {
            "steps": 30000, "batch": 16, "max-frames": 16000, "crop": 2.0, "bucket-ratio": 1.125, "rate": 24000, "max-hz": 10500,
            "cremad": 0.0, "lr": 0.001, "warmup": 1000, "duration-weight": 1.0, "f0-weight": 2.0, "formant-weight": 1.0,
            "guide-floor": 0.1, "guide-steps": 0.3, "smooth-weight": 0.05, "frication-max-hz": 11000, "sonorant-frication": 1.0,
            "sonorant-af-db": 40.0, "speaker-noise": 0.03, "dropout": 0.1, "weight-decay": 0.0001, "adversarial": 0.0,
            "feature-matching": 1.0, "adversarial-start": 500, "critic-lr": 0.0002, "critic-precision": "bfloat16", "val-count": 480,
            "seed": 1
        },
        "a": {"steps": 30000, "stop": 15000, "lr": 0.001, "warmup": 1000, "seed": 1},
        "b": {"steps": 20000, "lr": 0.0005, "warmup": 500, "cremad": 0.2, "adversarial": 0.1, "adversarial-start": 1000, "guide-steps": 0.001,
              "seed": 1}
    },
    "distill": {
