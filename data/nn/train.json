            "bookCopies": 2,
            "actorShare": 0.08,
            "blendShare": 0.1,
            "emotionShare": 0.3,
            "intensity": [0.25, 1.0],
            "minTokens": 4,
            "maxTokens": 256,
            "valItems": 1500,
            "seed": 1
