            "mos": 0.05,
            "wer": 1.0,
            "similarity": 0.85
        },
        "samples": {
            "speakers": ["arctic-bdl", "arctic-slt"],
            "texts": ["melville-moby", "austen-pride"],
            "rate": 44100
