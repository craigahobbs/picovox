{
    "description": "Knowledge distillation of the multi-speaker acoustic model (nn/distill.py) - the teacher, its distillation set, the student ladder, the polish fine-tune, and the tolerance (fixed before any student is measured)",
    "teacher": "build/nn/runs/multi-b/best.pt",
    "targets": {
        "books": "build/nn/g2p/books",
        "bookCopies": 2,
        "actorShare": 0.08,
        "blendShare": 0.1,
        "emotionShare": 0.3,
        "intensity": [0.25, 1.0],
        "minTokens": 4,
        "maxTokens": 256,
        "valItems": 1500,
        "seed": 1
    },
    "train": {
        "steps": 20000,
        "batch": 48,
        "maxFrames": 24000,
        "lr": 0.0015,
        "warmup": 500,
        "durationWeight": 0.25,
        "dropout": 0.05,
        "weightDecay": 0.0001,
        "valEvery": 1000
    },
    "students": [
        {"name": "s96", "config": {"dim": 96, "decoderDim": 96, "encoderLayers": 3, "decoderLayers": 6}},
        {"name": "s80", "config": {"dim": 80, "decoderDim": 80, "encoderLayers": 3, "decoderLayers": 4}},
        {"name": "s64", "config": {"dim": 64, "decoderDim": 64, "encoderLayers": 3, "decoderLayers": 4}},
        {"name": "s48", "config": {"dim": 48, "decoderDim": 48, "encoderLayers": 2, "decoderLayers": 4}},
        {"name": "s32", "config": {"dim": 32, "decoderDim": 32, "encoderLayers": 2, "decoderLayers": 3}}
    ],
    "polish": {
        "steps": 2000,
        "lr": 0.0002,
        "warmup": 200,
        "cremad": 0.2,
        "adversarial": 0.1,
        "featureMatching": 1.0,
        "adversarialStart": 200,
        "guideSteps": 0.001,
        "valEvery": 500
    },
    "eval": {
        "speakers": [["arctic-slt", "female"], ["libritts-5895", "female"], ["libritts-6345", "female"],
                     ["arctic-bdl", "male"], ["libritts-5750", "male"], ["libritts-2843", "male"]],
        "rate": 16000,
        "valCount": 240
    },
    "tolerance": {
        "description": "The smallest student whose mean UTMOS is within mos of the teacher's, whose Whisper WER is at most wer points worse, and whose speaker similarity to the teacher is at least similarity - the per-speaker cosine of the mean ECAPA embedding of the student's panel renderings with the mean of the teacher's renderings of the same texts, averaged over the six speakers",
        "mos": 0.05,
        "wer": 1.0,
        "similarity": 0.85
    },
    "samples": {
        "speakers": ["arctic-bdl", "arctic-slt"],
        "texts": ["melville-moby", "austen-pride"],
        "rate": 44100
    }
}
